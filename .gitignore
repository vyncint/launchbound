target/
# GPU measurement evidence logs are for the human, not repo content (CLAUDE.md §5.2).
.gpu-evidence/
# Staged bench plans and box session outputs are artifacts, not source.
/plans/
/bench-session/
# `cargo oxide inspect` writes its lowering beside the kernel it lowered, so
# the command corpus/README.md tells a reader to run leaves the tree dirty.
# These are build outputs; the PTX that matters is recorded, not committed.
corpus/*/*.ptx
corpus/*/*.ll
